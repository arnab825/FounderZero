# ==============================================================================
# Autonomous Co-Founder - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Tavily Search API Key (Free tier at https://tavily.com/)
# If not set, duckduckgo-search is used automatically.
TAVILY_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Firebase Admin Configuration
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=founder-zero
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=founder-zero.appspot.com

# Optional: Vercel Deploy API Token (For live automatic Vercel deployments)
VERCEL_TOKEN=
VERCEL_PROJECT_NAME=

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=founder-zero.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=founder-zero
VITE_FIREBASE_STORAGE_BUCKET=founder-zero.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
