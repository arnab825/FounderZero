# ==============================================================================
# Security & Secret Protection (.gitignore)
# ==============================================================================

# Environment files containing sensitive API keys & credentials
.env
.env.local
.env.*.local
*.env
frontend/.env
backend/.env

# Google Cloud & Firebase Service Account Private Key JSON Files
founder-zero-firebase-adminsdk-fbsvc-4d157c2b90.json
*adminsdk*.json
*serviceaccount*.json
*service-account*.json
*.pem
*.key
*.p12

# Python Virtual Environments & Bytecode
backend/venv/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node.js & Frontend dependencies/builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
*.local

# Local Application Artifacts & Sandboxes
backend/static_sandbox/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS configuration
.vscode/
.idea/
.DS_Store
Thumbs.db
